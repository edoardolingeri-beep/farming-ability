{
  "name": "valle-girasole",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "build:artifact": "npm run build:single && node scripts/make-artifact.mjs"
  },
  "dependencies": {
    "@fontsource/lilita-one": "^5.3.0",
    "@fontsource/nunito": "^5.3.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
